{
  "name": "imperator",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node tools/check.js && node tools/bot.js 21 && node tools/build-site.mjs && node tools/check-bundle.mjs && node tools/smoke.mjs",
    "measure": "node sim/run.js --runs=25 --by=difficulty,road --pool=start --metrics=win,tookRome,tookThenLost",
    "measure:diplomacy": "node sim/ablate.js sim/ablations/diplomacy.js",
    "map": "node tools/build-map.js",
    "serve": "python3 -m http.server 8000",
    "measure:campaign": "node tools/measure-campaign.js",
    "measure:depth": "node sim/ablate.js sim/ablations/depth.js",
    "measure:buildings": "node sim/ablate.js sim/ablations/buildings.js",
    "measure:options": "node sim/ablate.js sim/ablations/options.js",
    "claims": "node sim/verify-claims.js sim/claims.js",
    "killgate": "node prototypes/killgate/run.js",
    "build": "node tools/build-site.mjs",
    "smoke": "node tools/smoke.mjs",
    "check-bundle": "node tools/check-bundle.mjs"
  }
}
