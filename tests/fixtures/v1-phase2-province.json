us Macer and Titus Licinius."},{"t":5,"loc":"NIT","text":"Marcus Cornelius, legate of I Italica, claims the purple in Northern Italy."},{"t":5,"loc":"JUD","text":"Decimus Tettius, legate of V Macedonica, claims the purple in Judaea."},{"t":5,"loc":null,"text":"A truce is agreed between Titus Licinius and Marcus Cornelius."},{"t":5,"loc":null,"text":"A truce is agreed between Decimus Tettius and Servius Sulpicius Galba."}],"rel":{"galba|player":-30,"galba|macer":-3,"F7|macer":15,"F14|F7":15,"F15|galba":15},"treaties":[{"id":1,"type":"alliance","a":"macer","b":"F7","target":"galba","hostages":false,"from":4,"until":16},{"id":2,"type":"truce","a":"F7","b":"F14","target":null,"hostages":false,"from":5,"until":11},{"id":3,"type":"truce","a":"F15","b":"galba","target":null,"hostages":false,"from":5,"until":11}],"peace":{"F7|macer":1,"F14|F7":2,"F15|galba":3},"offers":[],"clientsUsed":{},"nextTreaty":4,"pendingEnmity":["vespasian","galba","vitellius"],"spawnAt":[5,2,5,9,11,11],"minorSkip":{"vindex":false,"macer":false,"nymphidius":false,"capito":false,"albinus":false}}}