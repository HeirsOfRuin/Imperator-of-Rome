,"maxLegions":2,"debtPeak":852.4137931034483,"legionsTurn16":0,"aiTreaties":7,"treaties":1},"outcome":null,"ledger":[[0,15,"legate's salary"],[1,-40,"gift to Nero"],[1,-258.62,"bought a garrison"],[1,465,"provincial treasury: PAN"],[1,70,"revenue"],[1,-112.8,"pay"],[2,70,"revenue"],[2,-112.8,"pay"],[3,60,"provincial treasury: NOR"],[3,110,"revenue"],[3,-187.06,"pay"],[4,140,"revenue"],[4,-187.06,"pay"],[5,140,"revenue"],[5,-194.58,"pay"],[6,-50,"bought X-Gem"],[6,140,"revenue"],[6,-194.58,"pay"],[7,100,"dowry"],[7,140,"revenue"],[7,-194.58,"pay"],[8,-60,"senators"],[8,140,"revenue"],[8,-194.58,"pay"],[9,140,"revenue"],[9,-194.58,"pay"],[10,140,"revenue"],[10,-194.58,"pay"],[11,140,"revenue"],[11,-101.52,"pay"]],"pending":[{"id":50,"army":"A6","prov":"GSU","destination":true,"turn":11}],"dispatches":[{"t":0,"loc":"PAN","text":"March, AD 68. Word comes from Gaul: Julius Vindex, governor of Lugdunensis, has risen against Nero."},{"t":0,"loc":"PAN","text":"XIII Gemina takes your promises."},{"t":0,"loc":"LUG","text":"Julius Vindex, governor of Lugdunensis, raises the Gauls against Nero."},{"t":1,"loc":"PAN","text":"Pannonia is yours."},{"t":1,"loc":"TAR","text":"At Hispania Tarraconensis, the old governor Servius Sulpicius Galba lets his men hail him: legate of the Senate and People, he says, not yet emperor."},{"t":1,"loc":"GSU","text":"Titus Arrius, legate of IV Macedonica, claims the purple in Germania Superior."},{"t":1,"loc":null,"text":"Quintus Vibius swears to you when your province falls: a legate of one of your legions. He can command an army for you."},{"t":1,"loc":null,"text":"A truce is agreed between Titus Arrius and Gaius Julius Vindex."},{"t":2,"loc":"AFR","text":"In Africa, Clodius Macer, legate of III Augusta, holds back the grain ships and raises a legion of his own."},{"t":2,"loc":null,"text":"A truce is agreed between Servius Sulpicius Galba and Titus Arrius."},{"t":2,"loc":null,"text":"A truce is agreed between Titus Arrius and Lucius Clodius Macer."},{"t":2,"loc":null,"text":"A truce is agreed between Lucius Clodius Macer and Gaius Julius Vindex."},{"t":3,"loc":"ROM","text":"Nero is dead. Abandoned by the Praetorians, he took his own life outside Rome. The Senate rules, for now."},{"t":5,"loc":null,"text":"A truce is agreed between Titus Arrius and you."},{"t":5,"loc":"SYR","text":"Gaius Antonius, legate of IV Scythica, claims the purple in Syria."},{"t":6,"loc":"JUD","text":"Quintus Pomponius, legate of V Macedonica, claims the purple in Judaea."},{"t":7,"loc":"GIN","text":"On the lower Rhine, Fonteius Capito is said to want the purple for himself."},{"t":7,"loc":"MOE","text":"Gnaeus Plotius, legate of III Gallica, claims the purple in Moesia."},{"t":7,"loc":null,"text":"A truce is agreed between Titus Arrius and Gaius Julius Vindex."},{"t":8,"loc":null,"text":"A truce is agreed between Gaius Julius Vindex and Lucius Clodius Macer."},{"t":8,"loc":null,"text":"A truce is agreed between Titus Arrius and Lucius Clodius Macer."},{"t":8,"loc":"JUD","text":"Agrippa II sends 3000 men to Gaius Antonius."},{"t":9,"loc":null,"text":"Your legions hail you as imperator."},{"t":9,"loc":"MCA","text":"The Mauretanian chiefs send 3000 men to Lucius Clodius Macer."},{"t":10,"loc":"BRI","text":"On the Rhine, the legions refuse their oath and hail Aulus Vitellius emperor."},{"t":10,"loc":"ROM","text":"Marcus Salvius Otho, once Nero's friend, buys the Praetorians and claims the throne."},{"t":10,"loc":"SAR","text":"Battle near Caralis: Lucius Clodius Macer wins against Servius Sulpicius Galba."},{"t":10,"loc":"ROM","text":"The Senate recognises Marcus Salvius Otho as emperor."},{"t":11,"loc":"MOE","text":"The Roxolani cross the frozen Danube into Moesia."},{"t":11,"loc":"MOE","text":"Gnaeus Plotius buys VII Claudia."},{"t":11,"loc":"MOE","text":"Gnaeus Plotius buys VIII Augusta."},{"t":11,"loc":"LUG","text":"On the eve of battle, XXI Rapax goes over to Aulus Vitellius."}],"rel":{"F5|vindex":30,"F5|galba":15,"F5|macer":30,"macer|vindex":30,"F5|player":15,"F16|F22":-6,"F16|F26":-3,"F26|macer":-3},"treaties":[{"id":7,"type":"truce","a":"F5","b":"vindex","target":null,"hostages":false,"from":7,"until":13},{"id":8,"type":"truce","a":"vindex","b":"macer","target":null,"hostages":false,"from":8,"until":14},{"id":9,"type":"truce","a":"F5","b":"macer","target":null,"hostages":false,"from":8,"until":14}],"peace":{"F5|vindex":7,"macer|vindex":8,"F5|macer":9},"offers":[],"clientsUsed":{"agrippa":"F16","mauri":"macer"},"nextTreaty":10,"pendingEnmity":["vespasian","vespasian"],"spawnAt":[5,1,7,6,15,14],"minorSkip":{"vindex":false,"macer":false,"nymphidius":false,"capito":false,"albinus":false},"story":[],"lastAct":3,"eventsSeen":{"nero-levy":1,"mutinous-cohort":3,"deserters":5,"pay-day":6,"marriage":7,"senate-votes":8,"astrologer":9},"event":null,"report":null,"storyLog":[{"t":1,"title":"Orders from the palace","choice":"Pay it · 40k","text":"Your loyalty is noted in Rome."},{"t":3,"title":"A centurion is killed","choice":"Decimate the cohort","text":"The lots are drawn. Nobody forgets it."},{"t":5,"title":"Deserters","choice":"Enrol them in X Gemina","text":"They take the oath again, to you this time."},{"t":6,"title":"The centurions come","choice":"Pay something now · 50k","text":"The centurions leave satisfied."},{"t":7,"title":"An offer of marriage","choice":"Accept","text":"The wedding is quick, and well attended."},{"t":8,"title":"A letter from Rome","choice":"Send the money · 60k","text":"Your name is spoken kindly in the curia."},{"t":9,"title":"The astrologer","choice":"Keep him close; let the men hear","text":"By evening the whole camp knows your destiny."}],"neroPage":true,"battle":null}}