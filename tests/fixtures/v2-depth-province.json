lba","romeUnrest":0.20000000000000062,"act":1,"actIVOpen":false,"stats":{"smallFights":6,"largeFights":0,"pSmall":0,"pLarge":0,"buys":3,"negs":2,"negOK":2,"bypasses":0,"letters":0,"fightsWon":0,"fightsLost":0,"gainedBy":{"buy":3,"negotiate":2,"fight":0,"letter":0},"anchorSaves":0,"histZeroBeforeIV":0,"minorFolded":0,"procSpawned":3,"mutinies":0,"breaches":0,"romeTaken":0,"tookRome":false,"lostRome":false,"maxLegions":4,"debtPeak":885.0506756756758,"legionsTurn16":0,"tradeIncome":18,"taxIncome":810,"aiTreaties":2,"hostisAll":2,"motions":2},"outcome":null,"ledger":[[0,-351.35,"bought III-Gall"],[0,15,"legate's salary"],[1,-50,"bought IV-Scyth"],[1,-350.68,"bought VI-Ferr"],[1,15,"legate's salary"],[2,15,"legate's salary"],[3,1125,"provincial treasury: SYR"],[3,270,"revenue"],[3,6,"trade"],[3,-225.6,"pay"],[4,-60,"senators"],[4,-100,"exiles' estates restored"],[4,270,"revenue"],[4,6,"trade"],[4,-225.6,"pay"],[5,-200,"the Senate's decree"],[5,270,"revenue"],[5,6,"trade"],[5,-225.6,"pay"]],"pending":[],"dispatches":[{"t":0,"loc":"SYR","text":"March, AD 68. Word comes from Gaul: Julius Vindex, governor of Lugdunensis, has risen against Nero."},{"t":0,"loc":"SYR","text":"III Gallica takes your money."},{"t":0,"loc":"LUG","text":"Julius Vindex, governor of Lugdunensis, raises the Gauls against Nero."},{"t":1,"loc":"SYR","text":"VI Ferrata takes your money."},{"t":1,"loc":"TAR","text":"At Hispania Tarraconensis, the old governor Servius Sulpicius Galba lets his men hail him: legate of the Senate and People, he says, not yet emperor."},{"t":2,"loc":"SYR","text":"XII Fulminata takes your promises."},{"t":2,"loc":"AFR","text":"In Africa, Clodius Macer, legate of III Augusta, holds back the grain ships and raises a legion of his own."},{"t":2,"loc":"GSU","text":"Titus Licinius, legate of XXII Primigenia, claims the purple in Germania Superior."},{"t":2,"loc":null,"text":"A truce is agreed between Lucius Clodius Macer and Titus Licinius."},{"t":2,"loc":null,"text":"Lucius Clodius Macer has lost his last legion. His cause is finished."},{"t":3,"loc":"SYR","text":"Syria is yours."},{"t":3,"loc":"ROM","text":"Nero is dead. Abandoned by the Praetorians, he took his own life outside Rome. The Senate rules, for now."},{"t":3,"loc":null,"text":"Quintus Vibius swears to you when your province falls: a legate of one of your legions. He can command an army for you."},{"t":3,"loc":"ROM","text":"The Senate declares Titus Licinius a public enemy of the Roman people."},{"t":4,"loc":null,"text":"Your legions hail you as imperator."},{"t":4,"loc":"ROM","text":"Nero's exiles come home and get their estates back. Their families remember who did it."},{"t":5,"loc":"ROM","text":"The Senate names you legate of the Senate and People of Rome."},{"t":5,"loc":"NIT","text":"Decimus Antonius, legate of I Italica, claims the purple in Northern Italy."},{"t":5,"loc":"JUD","text":"Marcus Cornelius, legate of V Macedonica, claims the purple in Judaea."},{"t":5,"loc":"ROM","text":"The Senate declares Marcus Cornelius a public enemy of the Roman people."},{"t":5,"loc":null,"text":"A truce is agreed between Decimus Antonius and Titus Licinius."}],"rel":{"galba|player":-30,"F7|macer":15,"F7|galba":-3,"F13|F7":15},"treaties":[{"id":2,"type":"truce","a":"F13","b":"F7","target":null,"hostages":false,"from":5,"until":11}],"peace":{"F13|F7":2},"offers":[],"clientsUsed":{},"nextTreaty":3,"senate":{"favour":{"player":65.3521165991936,"vindex":42.674275053567996,"galba":50.437765570559996,"macer":20.656,"F7":0,"F13":25.112,"F14":0},"hostis":{"F7":15,"F14":17},"everHostis":{"galba>F7":true}},"foreign":{"subsidy":{},"incited":{},"parthia":null},"trade":[],"pendingEnmity":["vespasian","galba","vitellius"],"spawnAt":[5,2,5,9,11,11],"minorSkip":{"vindex":false,"macer":false,"nymphidius":false,"capito":false,"albinus":false},"story":[],"lastAct":3,"lastEmperor":"galba","deathsSeen":{},"eventsSeen":{"pay-day":1,"astrologer":3,"senate-votes":4,"senate-embassy":5},"event":null,"report":null,"storyLog":[{"t":1,"title":"The centurions come","choice":"Pay something now · 50k","text":"The centurions leave satisfied."},{"t":3,"title":"The astrologer","choice":"Keep him close; let the men hear","text":"By evening the whole camp knows your destiny."},{"t":4,"title":"A letter from Rome","choice":"Send the money · 60k","text":"Your name is spoken kindly in the curia."},{"t":5,"title":"An embassy from the Senate","choice":"Receive them with honour","text":"You listen, promise nothing, and send them home with an escort."}],"flags":{"astrologer":true},"neroPage":true}}